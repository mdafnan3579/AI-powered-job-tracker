# Supabase project URL — Supabase dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=your_url
# Supabase anon (public) key — Supabase dashboard > Project Settings > API > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Supabase service role key (server-only, never expose) — same page > service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_key
# Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key
# Model name, kept in one place so it can be swapped later
AI_MODEL=gemini-1.5-flash
